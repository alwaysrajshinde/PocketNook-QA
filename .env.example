# ==========================================================
# PocketNook Chat — Environment Configuration Template
# Never commit real API keys, tokens, or service accounts.
# Production secrets live in Google Cloud Secret Manager:
#   firebase functions:secrets:set LLM_API_KEY
# ==========================================================

# 1. Swappable LLM Provider Configuration
# Supported providers: gemini | openai | anthropic | mock
LLM_PROVIDER=gemini
# Exact model identifier (never hardcoded in source code)
LLM_MODEL=gemini-2.5-flash
LLM_MAX_OUTPUT_TOKENS=450
LLM_TIMEOUT_MS=20000

# Local Express dev only (production reads defineSecret('LLM_API_KEY'))
# LLM_API_KEY=

# 2. Authentication & Firebase App Check
# ID token verification is ALWAYS mandatory on /api/chat.
# App Check starts disabled; enable in monitor-only first before enforcing:
APP_CHECK_ENABLED=false
APP_CHECK_ENFORCE=false

# 3. Strict CORS Origin Allowlist (origin only, no trailing slash, no wildcards)
CORS_ALLOWED_ORIGINS=https://alwaysrajshinde.github.io,http://localhost:5173

# 4. Per-User Rate Limiting & Token Budgets (Firestore-backed in Functions)
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_PER_DAY=300
DAILY_TOKEN_BUDGET_PER_USER=100000
GLOBAL_DAILY_TOKEN_ALERT=2000000

# 5. Client Frontend Build Variables (safe public configuration only)
# Point static frontend builds (e.g. GitHub Pages) to the deployed Cloud Function URL:
# VITE_CHAT_API_URL=https://us-central1-<your-firebase-project>.cloudfunctions.net/chat
