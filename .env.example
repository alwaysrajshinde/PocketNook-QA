# ==========================================================
# PocketNook Chat — ₹0 Cloudflare Workers + AI Studio Config
# Never commit real API keys, tokens, or secrets.
# Deploy secrets on Cloudflare Workers Free Tier:
#   cd worker && npx wrangler secret put LLM_API_KEY
#   cd worker && npx wrangler secret put LOG_HMAC_SECRET
# ==========================================================

# 1. Global Kill Switch & Swappable LLM Provider Configuration
# Set AI_ENABLED=false in wrangler.toml (or env) to pause online AI immediately.
AI_ENABLED=true
# Supported providers: gemini | openai | anthropic | mock
LLM_PROVIDER=gemini
# Exact model identifier (never hardcoded in source code). Default free-tier AI Studio model:
LLM_MODEL=gemini-2.5-flash-lite
LLM_MAX_OUTPUT_TOKENS=450

# Local Express dev only (Cloudflare Worker reads encrypted Wrangler secrets)
# LLM_API_KEY=
# LOG_HMAC_SECRET=replace-with-random-32-byte-secret

# 2. Firebase Project Auth Configuration (Spark Free Plan)
# Worker verifies Firebase ID tokens via jose + Google public JWKS (RS256, iss, aud, sub, exp).
FIREBASE_PROJECT_ID=expense-tracker-d98cd
# Optional Firebase App Check (monitor-only or enforced)
APP_CHECK_ENABLED=false
APP_CHECK_ENFORCE=false

# 3. Strict CORS Origin Allowlist (origin only, no trailing slash, no wildcards)
CORS_ALLOWED_ORIGINS=https://alwaysrajshinde.github.io,http://localhost:5173

# 4. SQLite Durable Object Rate Limits & Global Free-Tier Cap
USER_PER_MIN_LIMIT=5
USER_DAILY_LIMIT=10
# Keep GLOBAL_DAILY_CAP safely below your AI Studio free-tier RPD (check aistudio.google.com/rate-limit)
GLOBAL_DAILY_CAP=150

# 5. Client Frontend Build Variables (safe public configuration only)
# Point static frontend builds (e.g. GitHub Pages) to the deployed Cloudflare Worker URL:
# VITE_CHAT_API_URL=https://pocketnook-ai-chat.<your-subdomain>.workers.dev/api/chat
