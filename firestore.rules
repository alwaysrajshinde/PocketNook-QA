rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Explicitly deny access to any unmapped root document by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Multi-tenant user root document and isolated user data space (Firebase Spark free plan)
    match /users/{userId} {
      // User can only read or write their own user profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Transactions subcollection: strict owner access
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Categories subcollection: strict owner access
      match /categories/{categoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Monthly summary roll-up cache subcollection: strict owner access
      match /months/{monthKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Chat session metadata (deleted on Clear Chat)
      match /chat_sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
